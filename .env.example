# Copy to .env and adjust. Never commit .env.
APP_ENV=dev
LOG_LEVEL=INFO

# Per-key token bucket (qps <= 0 disables rate limiting)
RATE_LIMIT_QPS=5
RATE_LIMIT_BURST=10

# Provider resilience
PROVIDER_MAX_RETRIES=2
PROVIDER_BACKOFF_SECONDS=0.5
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_SECONDS=30

# Direct-scrape stub stays off until implemented + compliance sign-off
DIRECT_SCRAPE_ENABLED=false

# Result-quality scoring (searchMeta):
# score = coverage*Wc + sufficiency*Ws - duplicateRate*Wd, degraded below threshold
QUALITY_WEIGHT_COVERAGE=0.5
QUALITY_WEIGHT_SUFFICIENCY=0.5
QUALITY_WEIGHT_DUPLICATES=0.3
QUALITY_DEGRADED_THRESHOLD=0.5
# engine coverage below this floor is degraded even with plenty of results
QUALITY_COVERAGE_FLOOR=0.4

# Rewrite natural-language questions into keyword queries for the metasearch
# backend ("who is the ceo of TNB in 2017" -> "ceo TNB 2017")
QUERY_REWRITE=true

# Log hygiene: raw query text is never logged unless this is true
LOG_QUERIES=false

# Egress classification gate (versioned deny-list; fail closed on match)
POLICY_PATH=policy/sensitive.yml

# Quality fall-through: degraded genxng responses retry via the commercial
# provider (needs COMMERCIAL_* configured; fails soft otherwise)
QUALITY_FALLTHROUGH=true

# Engine health probes: every round probes each enabled engine once through
# the egress — tune the interval to your measured ceiling; 0 disables
ENGINE_PROBE_INTERVAL=900
ENGINE_FAIL_THRESHOLD=3

# Outbound pacing toward the search backend (egress traffic). Set OUTBOUND_QPS
# from scripts/ceiling_probe.py's measured ceiling with headroom; 0 disables.
OUTBOUND_QPS=2
OUTBOUND_BURST=5
OUTBOUND_JITTER_SECONDS=0.3
OUTBOUND_MAX_WAIT_SECONDS=20

# Infrastructure (service names resolve inside docker compose)
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://gen:gen@postgres:5432/gen
SEARXNG_URL=http://searxng:8080

# Postgres container bootstrap
POSTGRES_USER=gen
POSTGRES_PASSWORD=gen
POSTGRES_DB=gen

# SearXNG
SEARXNG_SECRET=change-me-to-a-long-random-string

# Vault (optional — env vars are the dev fallback)
# VAULT_ADDR=https://vault.internal:8200
# VAULT_TOKEN=
# VAULT_MOUNT=secret
# VAULT_PATH=gen-api

# Commercial Gen-compatible provider (Phase 3). Set both to activate
# places/shopping/scholar/patents and optional /search enrichment.
# COMMERCIAL_BASE_URL=
# COMMERCIAL_API_KEY=
# SEARCH_ENRICHMENT=false

# --- Zero-container mode (Windows-native, no Docker) -------------------------
# For hosts that cannot run containers at all. Single worker process only.
# Prefer an absolute DB path; a relative one resolves against the project root
# (never the process working directory -- a Scheduled Task starts in System32).
# NOTE: .env itself is only found when the process starts in the project
# directory, so set "Start in" on the Scheduled Task either way.
# DATABASE_URL=sqlite:///C:/gen-api/data/gen.db
# REDIS_URL=memory://
# SEARXNG_URL=http://localhost:8080
